BETTER_AUTH_URL=http://localhost:3000
# Generate a new secret locally: openssl rand -hex 32
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET
HIKMAH_OWNER_EMAIL=owner@example.com
# Use an absolute path in production. Docker sets /data.
HIKMAH_DATA_DIR=.data
# The execution sidecar. Signs single-use terminal tickets and authenticates the
# app to the workbench, so both services must hold the same value.
# Generate: openssl rand -hex 32 — configure.py does this for you on a server.
HIKMAH_WORKBENCH_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
HIKMAH_WORKBENCH_URL=http://localhost:3001

# A provider key for the whole deployment, used when a run carries no saved key
# of its own. Owners normally set theirs under Settings -> Connection in the
# chat instead, which keeps it encrypted in the database rather than in the
# environment. Without either, a run against a hosted provider is refused with
# that reason rather than queued and failed.
# HIKMAH_PROVIDER_KEY=

# Image and speech generation, which go through OpenRouter. Leave this unset
# when the workspace already runs on OpenRouter: a run's own key is used, so
# media needs no second credential. Set it only to generate media while chatting
# through some other provider. Without either, the media tools are not offered
# rather than offered and failing on every call.
# HIKMAH_MEDIA_KEY=
# Which models to generate with, when neither the owner nor the model names one.
# HIKMAH_IMAGE_MODEL=openai/gpt-image-1
# HIKMAH_SPEECH_MODEL=openai/gpt-4o-mini-tts
# HIKMAH_SPEECH_VOICE=alloy
