{
  "name": "hikmah-workspace",
  "version": "9.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "predev": "npm run build:worker",
    "dev": "next dev --webpack",
    "build": "npm run build:worker && next build --webpack",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "lint:styles": "node scripts/check-styles.mjs",
    "lint:reach": "node scripts/check-reachable.mjs",
    "setup": "node --env-file-if-exists=.env.local scripts/setup.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:production": "node scripts/test-standalone.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:worker": "node scripts/build-sandbox-worker.mjs && node scripts/build-automatic-worker.mjs",
    "design:build": "node scripts/build-design.mjs",
    "design:check": "node scripts/build-design.mjs --check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/mcp": "2.0.104",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@ai-sdk/react": "4.0.185",
    "@better-auth/stripe": "^1.7.27",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@streamdown/cjk": "1.0.5",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.4",
    "@streamdown/mermaid": "1.0.4",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ai": "7.0.180",
    "better-auth": "^1.7.27",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.78.0",
    "motion": "^13.2.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "quickjs-emscripten-core": "0.32.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4.24.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.39.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "streamdown": "2.8.0",
    "stripe": "^22.6.2",
    "tailwind-merge": "3.7.1",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "web-vitals": "6.2.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@astryxdesign/core": "0.7.17",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "ssh2": "1.17.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
