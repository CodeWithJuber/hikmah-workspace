{$HIKMAH_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
  # The terminal socket, before the app route: Next.js cannot serve a
  # WebSocket, so /ws/* belongs to the workbench. stream_timeout keeps a long
  # idle session alive and stream_close_delay stops a config reload from
  # dropping every open terminal.
  #
  # handle_path, not handle: the plain form matches the prefix and forwards it
  # unchanged, so the workbench received /ws/terminal and rejected the upgrade.
  # The workbench now accepts both spellings, but it should still be given the
  # path it documents.
  handle_path /ws/* {
    reverse_proxy workbench:3001 {
      stream_timeout 24h
      stream_close_delay 5m
    }
  }
  # Everything else is the app. Both routes use handle blocks so the match is
  # first-wins by the order written here rather than by directive sorting.
  # lb_try_duration: while the app container is being replaced by a release,
  # a dial fails for the seconds it takes to boot. Caddy keeps trying for up
  # to two minutes and answers the request when the new app is up, so a
  # release is a pause for whoever is on the site, never an error page.
  handle {
    reverse_proxy app:3000 {
      lb_try_duration 2m
      lb_try_interval 1s
      flush_interval -1
      header_up X-Real-IP {remote_host}
      header_up -oai-authenticated-user-id
      header_up -oai-authenticated-user-email
      header_up -oai-authenticated-user-full-name
    }
  }
}
