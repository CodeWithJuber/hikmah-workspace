{$HIKMAH_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
  # The terminal socket, before the app route: Next.js cannot serve a
  # WebSocket, so this one path belongs to the workbench. stream_timeout keeps a
  # long idle session alive and stream_close_delay stops a config reload from
  # dropping every open terminal.
  #
  # /ws/terminal*, not /ws/*: the wide form published the *whole* workbench,
  # including `POST /runs` — the endpoint that executes the assistant's shell
  # commands — so `POST https://<domain>/ws/runs` reached it with nothing in
  # front but one shared bearer token. The browser needs exactly one thing from
  # this service; the app reaches /runs over the Compose network, which is not
  # published at all.
  #
  # `handle`, not `handle_path`, and this is the part that is easy to get wrong:
  # handle_path strips the *matched* prefix, so `handle_path /ws/terminal*` would
  # strip `/ws/terminal` and hand the workbench `/`, which it rejects — the
  # terminal would break in exactly the way it broke before. Measured against
  # caddy 2.8.4 rather than reasoned about:
  #
  #   handle_path /ws/*          /ws/terminal -> /terminal      /ws/runs -> /runs
  #   handle_path /ws/terminal*  /ws/terminal -> /              /ws/runs -> the app
  #   handle      /ws/terminal*  /ws/terminal -> /ws/terminal   /ws/runs -> the app
  #
  # The last is the only row that is both narrow and working. It relies on the
  # workbench accepting `/ws/terminal` as well as `/terminal`, which it already
  # does (workbench/src/server.ts, TERMINAL_PATHS) — added so that a proxy change
  # could not break this again, and this is that change.
  handle /ws/terminal* {
    reverse_proxy workbench:3001 {
      stream_timeout 24h
      stream_close_delay 5m
    }
  }
  # Everything else is the app. Both routes use handle blocks so the match is
  # first-wins by the order written here rather than by directive sorting.
  # lb_try_duration: while the app container is being replaced by a release,
  # a dial fails for the seconds it takes to boot. Caddy keeps trying for up
  # to two minutes and answers the request when the new app is up, so a
  # release is a pause for whoever is on the site, never an error page.
  handle {
    reverse_proxy app:3000 {
      lb_try_duration 2m
      lb_try_interval 1s
      flush_interval -1
      header_up X-Real-IP {remote_host}
      header_up -oai-authenticated-user-id
      header_up -oai-authenticated-user-email
      header_up -oai-authenticated-user-full-name
    }
  }
}
